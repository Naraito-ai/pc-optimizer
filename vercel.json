{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "optimizer.exe", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/optimizer.exe",
      "dest": "/optimizer.exe",
      "headers": {
        "Content-Type": "application/octet-stream",
        "Content-Disposition": "attachment; filename=\"optimizer.exe\""
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
